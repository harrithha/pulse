{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "functions": {
    "api/news.ts": {
      "maxDuration": 60,
      "includeFiles": "{vite-plugin-news.ts,pulse-tts.ts,src/lib/articleText.ts}"
    },
    "api/article.ts": {
      "maxDuration": 30,
      "includeFiles": "{vite-plugin-news.ts,pulse-tts.ts,src/lib/articleText.ts}"
    },
    "api/tts.ts": {
      "maxDuration": 60,
      "includeFiles": "pulse-tts.ts"
    }
  }
}
